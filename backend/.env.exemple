# Configuration des variables d'environnement pour le backend AIGM
# Renseignez vos clés API ci-dessous

# Fournisseur LLM principal (openai, google, anthropic)
LLM_PROVIDER=openai

# Clé API OpenAI (nécessaire si LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Modèle OpenAI par défaut
OPENAI_MODEL=gpt-4o-mini

# Clé API Google (nécessaire si LLM_PROVIDER=google)
GOOGLE_API_KEY=your_google_api_key_here

# Modèle Gemini par défaut
GEMINI_MODEL=gemini-1.5-pro

# Autres configurations possibles (ajoutez si nécessaire)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here