# Template for the AIGM production deployment (NAS + Traefik).
#
# Copy this to `.env.production` (gitignored, never commit real values) and
# fill in real values. Used by docker-compose.prod.yml via `env_file`.
#
# See DEPLOY.md for the one-time setup and update procedure.

# --- Postgres --------------------------------------------------------------
# Password for the `aigm` Postgres role/database created by the postgres
# service in docker-compose.prod.yml. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# The backend's DATABASE_URL is derived from POSTGRES_PASSWORD directly in
# docker-compose.prod.yml (postgres service name as host) -- you do not
# need to set DATABASE_URL yourself here. Leave it unset unless you're
# pointing the backend at a different DB than the bundled postgres service.
# DATABASE_URL=postgresql+asyncpg://aigm:<POSTGRES_PASSWORD>@postgres:5432/aigm

# --- CORS --------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend to call the API
# from. No wildcard in production.
CORS_ORIGINS=https://jdr.yvenat.eu

# --- Auth ----------------------------------------------------------------
# Signs JWTs -- required, no default. Generate with: openssl rand -hex 32
SECRET_KEY=
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM provider ----------------------------------------------------------
# "openai" or "google" -- selects which client below is used by the
# narrator/arbitrator/router/scene_editor/image_prompter agents.
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- Image generation --------------------------------------------------
# "openai" (DALL-E) or "google" (Imagen via GOOGLE_API_KEY above).
IMAGE_PROVIDER=openai

# --- Voice / TTS -------------------------------------------------------
# Voice narration is opt-in per game session (toggled in-app via
# PUT /sessions/{id}/voice, defaults to off -- no env var controls the
# default). These only matter once a session enables it; uses
# OPENAI_API_KEY above.
TTS_MODEL=tts-1
TTS_VOICE=alloy

# --- Uvicorn workers -----------------------------------------------------
# Defaults to 1 in backend/Dockerfile. Do NOT raise this without first
# fixing the WebSocket ConnectionManager and the ChromaDB client in
# src/memory/vector_db.py (both are per-process in-memory state -- see
# DEPLOY.md and the Phase E report). Uncomment only after that's addressed.
# UVICORN_WORKERS=1
